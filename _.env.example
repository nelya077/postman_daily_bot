BOT_TOKEN=сюда_токен_от_BotFather

# LLM: Google Gemini API, бесплатный тариф (ключ: aistudio.google.com/apikey)
# Без ключа бот работает по ключевым словам, без пересказов.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# 1 = если лент не хватило, добавлять новости по темам из поиска Google Новостей
WEB_SEARCH_IN_DIGEST=1
