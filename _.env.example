BOT_TOKEN=сюда_токен_от_BotFather

# --- GigaChat (необязательно: без ключа бот работает по ключевым словам, без пересказов) ---
# «Ключ авторизации» из личного кабинета Studio (Настройки API), не токен доступа
GIGACHAT_AUTH_KEY=
# Корневой сертификат НУЦ Минцифры (без него будет CERTIFICATE_VERIFY_FAILED).
# Путь можно указать относительно папки проекта.
GIGACHAT_CA_BUNDLE=russian_trusted_root_ca_pem.crt
# Необязательно:
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# 1 = если лент не хватило, добавлять новости по темам из поиска Google Новостей
WEB_SEARCH_IN_DIGEST=1
